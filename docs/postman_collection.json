{
  "info": {
    "name": "My API - Complete Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete Postman collection for the Hobby-Projects API including Auth, Users, Generic CRUD, Work Tracker, and YTDB features."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "app_id", "value": "myApp", "type": "string" },
    { "key": "feature_name", "value": "alpha", "type": "string" },
    { "key": "record_id", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "workLogId", "value": "", "type": "string" },
    { "key": "commentId", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "listId", "value": "", "type": "string" },
    { "key": "videoId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints for user registration and login.",
      "item": [
        {
          "name": "API Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\",\n  \"app_id\": \"{{app_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-App-Id", "value": "{{app_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json && json.token){ pm.environment.set('token', json.token); }",
                  "if(json.user && json.user.id){ pm.environment.set('userId', json.user.id); }",
                  "if(json && json.token){ pm.collectionVariables.set('token', json.token); }",
                  "if(json.user && json.user.id){ pm.collectionVariables.set('userId', json.user.id); }"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
