# Application Environment (production, development, staging)
APP_ENV=development
DB_HOST=localhost
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
# Comma-separated list of Registration disbaled app_id's (e.g., work_tracker,ytdb )
REGISTRATION_DISABLED=work_tracker
JWT_SECRET_KEY=secret123
JWT_ISSUER=your_domain.com
JWT_AUDIENCE=your_domain.com
JWT_EXPIRATION_TIME=3600
YOUTUBE_API_KEY=<api-key>
# Comma-separated list of allowed origins for CORS (e.g., https://example.com,https://app.example.com)
# Use * to allow all origins (not recommended for production)
ALLOWED_ORIGINS=*